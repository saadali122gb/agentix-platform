# --- Server ---------------------------------------------------------------
PORT=8787
# Comma-separated list of allowed origins (your GitHub Pages URL + localhost).
CORS_ORIGIN=http://localhost:5173

# --- LLM providers --------------------------------------------------------
# The provider is chosen per-agent from the model id (claude* -> Anthropic,
# gemini* -> Google). LLM_PROVIDER is the fallback when a model is ambiguous.
# Leave all blank to run in mock mode (no real model calls).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# Google Gemini (AI Studio key, usually starts with "AIza").
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional fallback provider: anthropic | gemini
LLM_PROVIDER=

# --- Embeddings (for RAG) -------------------------------------------------
# Provider: voyage (Anthropic-recommended) or openai.
EMBEDDINGS_PROVIDER=voyage
EMBEDDINGS_API_KEY=
EMBEDDINGS_MODEL=voyage-3
# MUST match the vector(N) dimension in db/schema.sql.
# voyage-3 = 1024, OpenAI text-embedding-3-small = 1536.
EMBEDDING_DIM=1024

# --- Vector store / database (Supabase + pgvector) ------------------------
# Run backend/db/schema.sql in your Supabase project first.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Racing Snail CRM -----------------------------------------------------
RACING_SNAIL_API_URL=
RACING_SNAIL_API_KEY=

# --- Communication channels ----------------------------------------------
SLACK_WEBHOOK_URL=
# OAuth app IDs (per-user access tokens are passed per request, not stored here)
MS_CLIENT_ID=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
